---
import { Image } from 'astro:assets';
import site from '../content/site.json';
import portrait from '../assets/jessica-tan-portrait.png';

const { eyebrow, headline, intro, location } = site.hero;

// Break a multi-sentence headline onto one line per sentence so a punchy,
// short-clause headline (e.g. "X. Y. I do both.") lands as intended
// rhythmic beats instead of being wrapped mid-sentence by text-wrap:balance,
// which only balances character count and doesn't know about sentences.
// A single-sentence headline is unaffected (splits into one line, no <br>).
const headlineLines = headline.split(/(?<=[.!?])\s+/).filter(Boolean);
---

<section class="hero">
	<div class="wrap">
		<p class="eyebrow">{eyebrow}</p>
		<div class="hero-grid">
			<div class="hero-content">
				<h1>
					{headlineLines.map((line, i) => (
						<>
							{line}
							{i < headlineLines.length - 1 && <br />}
						</>
					))}
				</h1>
				<p class="hero-intro">{intro}</p>
			</div>
			<div class="hero-media">
				<div class="hero-portrait-frame">
					<Image
						class="hero-portrait"
						src={portrait}
						width={840}
						format="webp"
						loading="eager"
						fetchpriority="high"
						alt="Jessica Tan"
					/>
				</div>
				<p class="hero-loc">
					{location.map((line, i) => (
						<>
							{i > 0 && <br />}
							{line}
						</>
					))}
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: var(--space-hero-top);
		padding-bottom: var(--space-section);
	}

	.eyebrow {
		font-size: var(--size-eyebrow);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-blue);
		margin: 0 0 var(--space-20);
	}

	.hero-grid {
		--portrait-w: clamp(240px, 31.25vw, 320px);
		display: grid;
		grid-template-columns: 1fr var(--portrait-w);
		align-items: start;
		gap: var(--space-xl);
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--size-hero);
		line-height: 1.18;
		color: var(--color-ink);
		max-width: 26ch;
		text-wrap: balance;
		margin: 0 0 var(--space-28);
	}

	.hero-intro {
		font-size: clamp(1rem, 0.88rem + 0.5vw, 1.25rem);
		max-width: 100%;
		margin: 0;
		color: var(--color-body);
	}

	.hero-media {
		width: 100%;
		max-width: var(--portrait-w);
		margin: 0 auto;
		align-self: start;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-lg);
	}

	.hero-portrait-frame {
		width: 100%;
		aspect-ratio: 4 / 5;
	}

	.hero-portrait {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		border-radius: var(--radius-sm);
		display: block;
	}

	.hero-loc {
		font-size: var(--size-caption);
		color: var(--color-body);
		text-align: center;
		line-height: 1.5;
		margin: 0;
	}

	@media (max-width: 767px) {
		.hero-grid {
			--portrait-w: 260px;
			grid-template-columns: 1fr;
		}
	}
</style>
